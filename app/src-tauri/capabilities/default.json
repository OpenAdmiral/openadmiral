{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the agents' floating windows",
  "windows": ["main", "float-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "opener:default",
    "dialog:default",
    "notification:default"
  ]
}
