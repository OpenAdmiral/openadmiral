{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAdmiral",
  "version": "0.1.11",
  "identifier": "com.openadmiral.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "sh scripts/universal-helper.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenAdmiral",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 600,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/.claude/openadmiral/artifacts/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchDaemons/com.openadmiral.helper.plist": "./LaunchDaemons/com.openadmiral.helper.plist"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QzdFMzUyQTQ4REM2NTkKUldSWnhvMmtVdVBIaWZmQnYwZHZ3a29xY0Y5NnZhckZPY3dXZ1JZYVljajdtT2RNK3cxdFJWT0kK",
      "endpoints": [
        "https://openadmiral.com/updates/latest.json"
      ]
    }
  }
}
