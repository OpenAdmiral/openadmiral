<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Underway's privileged helper (src/bin/openadmiral-helper.rs). Bundled at
     Contents/Library/LaunchDaemons and registered by the app with SMAppService:
     macOS asks the person to allow it in System Settings → Login Items. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.openadmiral.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/openadmiral-helper</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.openadmiral.desktop</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardErrorPath</key>
	<string>/var/log/com.openadmiral.helper.log</string>
</dict>
</plist>
